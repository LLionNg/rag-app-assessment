# Secrets only. Everything else is configured in config.yml.
# Copy to .env and fill in the provider you enabled under `llm.provider`.

# Bangkok Bank assessment gateway (gpt-5-mini via Azure API Management)
BBL_LLM_API_KEY=

# Azure OpenAI, called directly rather than through the gateway
AZURE_OPENAI_API_KEY=

# OpenAI-compatible endpoints (OpenAI, OpenRouter, vLLM, ...)
OPENAI_API_KEY=
